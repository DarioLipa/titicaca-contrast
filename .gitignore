# Entorno y dependencias
node_modules/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Compilacion y distribucion
web/dist/
dist/
build/
.vite/
*.zip

# Secretos y credenciales
.env
.env.*
.netrc
*.key
*.pem
credentials.json
tokens.json

